# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=emg
POSTGRES_PASSWORD=change-me
POSTGRES_DB=emg
# Used by the API/worker when not running in docker-compose:
DATABASE_URL=postgresql://emg:change-me@localhost:5432/emg

# Object storage for original uploads and report versions: local | s3
STORAGE_BACKEND=local
STORAGE_DIR=./storage
# For S3/MinIO:
# STORAGE_BACKEND=s3
# S3_BUCKET=emg-ops
# S3_ENDPOINT=http://minio:9000
# AWS_ACCESS_KEY_ID=emg
# AWS_SECRET_ACCESS_KEY=change-me
MINIO_ROOT_USER=emg
MINIO_ROOT_PASSWORD=change-me

# Web app origin(s) allowed to call the API; set COOKIE_SECURE=0 only for plain-http local dev
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=0

# Timezone for business weeks and leaderboards
EMG_TIMEZONE=America/New_York

# Email (Phase 2). Sending stays disabled until EMAIL_SEND_ENABLED=1.
EMAIL_SEND_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=payroll@example.com
EMAIL_WEBHOOK_SECRET=

# Sales map (Phase 3). Geocoder: census (US Census batch geocoder, free, no key).
GEOCODER=census
GEOCODE_TIMEOUT=300
MAP_MIN_CONFIDENCE=0.8
# Map tiles load in the user's browser. Use a provider you have rights to for production traffic.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Vendor connectors. Credentials are encrypted with this key (generate: python -m emg.cli connector-key).
# Keep it secret and backed up: losing it means re-entering every portal password.
CONNECTOR_SECRET_KEY=
# Only needed when Chromium is not where Playwright expects it:
# PLAYWRIGHT_CHROMIUM_PATH=/path/to/chrome
